generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int                      @id @default(autoincrement())
  publicId      String                   @unique @default(cuid())
  utorid        String                   @unique
  barcodeNumber String?                  @unique
  email         String?
  firstName     String?
  lastName      String?
  isInstructor  Boolean                  @default(false)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  studentNumber String?                  @unique @map("student_number")
  memberships   OfferingMember[]
  visits        OfficeHourAttendance[]        @relation("StudentVisits")
  records       OfficeHourAttendanceRecord[]  @relation("StudentRecords")
  interests     OfficeHourInterest[]
  scheduleHosts OfficeHourScheduleHost[]
  sessionHosts  OfficeHourSessionHost[]
}

model Course {
  id        Int              @id @default(autoincrement())
  code      String           @unique
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  offerings CourseOffering[]
}

model CourseOffering {
  id         Int                  @id @default(autoincrement())
  publicId   String               @unique @default(cuid())
  courseId   Int
  termCode   String
  archivedAt DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  course     Course               @relation(fields: [courseId], references: [id])
  members    OfferingMember[]
  schedules  OfficeHourSchedule[]
  sessions   OfficeHourSession[]

  @@unique([courseId, termCode])
  @@index([termCode])
  @@index([archivedAt])
}

model OfferingMember {
  id         Int            @id @default(autoincrement())
  userId     Int
  offeringId Int
  role       CourseRole
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  offering   CourseOffering @relation(fields: [offeringId], references: [id])
  user       User           @relation(fields: [userId], references: [id])

  @@unique([userId, offeringId])
  @@index([offeringId, role])
}

model OfficeHourSchedule {
  id           Int                      @id @default(autoincrement())
  publicId     String                   @unique @default(cuid())
  offeringId   Int
  title        String
  type         OfficeHourType
  dayOfWeek    Int
  startMinute  Int
  endMinute    Int
  location     String?
  validFrom    DateTime?
  validUntil   DateTime?
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  blockGroupId String?
  offering     CourseOffering           @relation(fields: [offeringId], references: [id])
  hosts        OfficeHourScheduleHost[]
  sessions     OfficeHourSession[]

  @@index([offeringId, isActive])
  @@index([offeringId, blockGroupId])
}

model OfficeHourScheduleHost {
  id         Int                @id @default(autoincrement())
  scheduleId Int
  userId     Int
  role       CourseRole
  schedule   OfficeHourSchedule @relation(fields: [scheduleId], references: [id])
  user       User               @relation(fields: [userId], references: [id])

  @@unique([scheduleId, userId])
  @@index([userId])
}

model OfficeHourSession {
  id          Int                     @id @default(autoincrement())
  publicId    String                  @unique @default(cuid())
  offeringId  Int
  scheduleId  Int?
  title       String
  type        OfficeHourType
  startsAt    DateTime
  endsAt      DateTime
  location    String?
  status      OfficeHourSessionStatus @default(SCHEDULED)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  attendances OfficeHourAttendance[]
  records     OfficeHourAttendanceRecord[]
  interests   OfficeHourInterest[]
  offering    CourseOffering          @relation(fields: [offeringId], references: [id])
  schedule    OfficeHourSchedule?     @relation(fields: [scheduleId], references: [id])
  hosts       OfficeHourSessionHost[]

  @@index([offeringId, startsAt])
  @@index([status])
}

model OfficeHourSessionHost {
  id                Int                          @id @default(autoincrement())
  sessionId         Int
  userId            Int
  role              CourseRole
  helpedAttendances OfficeHourAttendance[]
  helpedRecords     OfficeHourAttendanceRecord[]
  session           OfficeHourSession            @relation(fields: [sessionId], references: [id])
  user              User                         @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@index([userId])
}

model OfficeHourInterest {
  id        Int                   @id @default(autoincrement())
  userId    Int
  sessionId Int
  createdAt DateTime              @default(now())
  session   OfficeHourSession     @relation(fields: [sessionId], references: [id])
  user      User                  @relation(fields: [userId], references: [id])
  reminders OfficeHourReminder[]

  @@unique([userId, sessionId])
  @@index([sessionId])
}

// One row per reminder actually sent for an interest, at a given lead time
// (minutesBefore, e.g. 60 or 1440). The unique constraint makes sending
// idempotent — a tier is emailed at most once per interest, so the cron can
// run as often as it likes without duplicating reminders.
model OfficeHourReminder {
  id            Int                @id @default(autoincrement())
  interestId    Int
  minutesBefore Int
  sentAt        DateTime           @default(now())
  interest      OfficeHourInterest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([interestId, minutesBefore])
}

// Active queue state only — a student is here while WAITING or IN_HELP.
// When help ends (END / NO_SHOW / CANCELLED), this row is deleted and a
// permanent record is written to OfficeHourAttendanceRecord instead.
model OfficeHourAttendance {
  id             Int                    @id @default(autoincrement())
  publicId       String                 @unique @default(cuid())
  sessionId      Int
  studentId      Int
  helpedByHostId Int?
  checkedInAt    DateTime               @default(now())
  helpStartedAt  DateTime?
  status         AttendanceStatus       @default(WAITING)
  helpedByHost   OfficeHourSessionHost? @relation(fields: [helpedByHostId], references: [id])
  session        OfficeHourSession      @relation(fields: [sessionId], references: [id])
  student        User                   @relation("StudentVisits", fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([sessionId, status, checkedInAt])
  @@index([studentId])
  @@index([helpedByHostId])
}

// Permanent history — written when a student's attendance is resolved.
// outcome records why the attendance ended (COMPLETED / NO_SHOW / CANCELLED).
model OfficeHourAttendanceRecord {
  id             Int                    @id @default(autoincrement())
  publicId       String                 @unique @default(cuid())
  sessionId      Int
  studentId      Int
  helpedByHostId Int?
  checkedInAt    DateTime
  helpStartedAt  DateTime?
  helpEndedAt    DateTime?
  outcome        AttendanceOutcome
  createdAt      DateTime               @default(now())
  helpedByHost   OfficeHourSessionHost? @relation(fields: [helpedByHostId], references: [id])
  session        OfficeHourSession      @relation(fields: [sessionId], references: [id])
  student        User                   @relation("StudentRecords", fields: [studentId], references: [id])

  @@index([sessionId, outcome])
  @@index([studentId])
  @@index([helpedByHostId])
}

enum OfficeHourSessionStatus {
  SCHEDULED
  ACTIVE
  DELAYED
  CANCELLED
  COMPLETED
}

// Active states only — lives in OfficeHourAttendance
enum AttendanceStatus {
  WAITING
  IN_HELP
}

// Terminal outcomes — lives in OfficeHourAttendanceRecord
enum AttendanceOutcome {
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum CourseRole {
  STUDENT
  TA
  INSTRUCTOR
}

enum OfficeHourType {
  REGULAR
  GROUP
  DEBUGGING
}
